<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.javafx_hibernate.EquipoController">
    <top>
        <Label text="Equipos (Hibernate + MySQL)" style="-fx-font-size: 18px;">
            <BorderPane.margin>
                <Insets bottom="8.0" left="12.0" right="12.0" top="12.0"/>
            </BorderPane.margin>
        </Label>
    </top>
    <center>
        <TableView fx:id="tableView" tableMenuButtonVisible="true">
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
            <columns>
                <TableColumn fx:id="idColumn" prefWidth="80.0" text="ID"/>
                <TableColumn fx:id="nombreColumn" prefWidth="220.0" text="Nombre"/>
                <TableColumn fx:id="categoriaColumn" prefWidth="220.0" text="Categoría"/>
                <TableColumn fx:id="disponibleColumn" prefWidth="140.0" text="Disponible"/>
            </columns>
        </TableView>
    </center>
</BorderPane>
